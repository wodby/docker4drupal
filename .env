### Documentation available at https://wodby.com/docs/stacks/drupal/local
### Changelog can be found at https://github.com/wodby/docker4drupal/releases
### Images tags format explained at https://github.com/wodby/docker4drupal#images-tags

### PROJECT SETTINGS

PROJECT_NAME=my_drupal11_project
PROJECT_BASE_URL=drupal.docker.localhost
PROJECT_PORT=8000

DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=password
DB_HOST=mariadb
DB_PORT=3306
DB_DRIVER=mysql

### --- MARIADB ----

MARIADB_TAG=11.8-r1
#MARIADB_TAG=11.4-r1
#MARIADB_TAG=10.11-r1
#MARIADB_TAG=10.6-r1

### --- DRUPAL CMS ----

DRUPAL_CMS_TAG=2-r4

### --- VANILLA DRUPAL ----

DRUPAL_TAG=11-r3
#DRUPAL_TAG=10-r3

### --- PHP ----

# Linux (uid 1000 gid 1000)

PHP_TAG=8.5-dev-r3
#PHP_TAG=8.4-dev-r3
#PHP_TAG=8.3-dev-r3
#PHP_TAG=8.2-dev-r3

# macOS (uid 501 gid 20)

#PHP_TAG=8.5-dev-macos-r3
#PHP_TAG=8.4-dev-macos-r3
#PHP_TAG=8.3-dev-macos-r3
#PHP_TAG=8.2-dev-macos-r3

### --- NGINX ----

