### Documentation available at https://wodby.com/docs/1.0/stacks/drupal/local
### Changelog can be found at https://github.com/wodby/docker4drupal/releases
### Images tags format explained at https://github.com/wodby/docker4drupal#images-tags

### PROJECT SETTINGS

PROJECT_NAME=my_drupal11_project
PROJECT_BASE_URL=drupal.docker.localhost
PROJECT_PORT=8000

DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=drupal
DB_ROOT_PASSWORD=password
DB_HOST=mariadb
DB_PORT=3306
DB_DRIVER=mysql

### --- MARIADB ----

MARIADB_TAG=11.8-r18
#MARIADB_TAG=12.3-r18
#MARIADB_TAG=11.4-r18
#MARIADB_TAG=10.11-r18
#MARIADB_TAG=10.6-r18

### --- DRUPAL CMS ----

DRUPAL_CMS_TAG=2-r31

### --- VANILLA DRUPAL ----

DRUPAL_TAG=11-r25
#DRUPAL_TAG=10-r25

### --- PHP ----

# Linux (uid 1000 gid 1000)

PHP_TAG=8.5-dev-r19
#PHP_TAG=8.4-dev-r19
